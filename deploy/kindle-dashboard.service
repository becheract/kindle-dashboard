[Unit]
Description=Kindle Dashboard - Kindle highlights and vocabulary dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kindle-dashboard
Group=kindle-dashboard
WorkingDirectory=/opt/kindle-dashboard
EnvironmentFile=/etc/kindle-dashboard.env
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings src/server/index.ts
Restart=on-failure
RestartSec=5

# Hardening: the app only needs to write its database folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kindle-dashboard

[Install]
WantedBy=multi-user.target
