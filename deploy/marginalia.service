[Unit]
Description=Marginalia - Kindle highlights and vocabulary dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=marginalia
Group=marginalia
WorkingDirectory=/opt/marginalia
EnvironmentFile=/etc/marginalia.env
ExecStart=/usr/bin/node --experimental-strip-types --no-warnings src/server/index.ts
Restart=on-failure
RestartSec=5

# Hardening: the app only needs to write its database folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/marginalia

[Install]
WantedBy=multi-user.target
