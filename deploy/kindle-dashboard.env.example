# Port the site listens on. Open http://<server-ip>:3000 from any device on your network.
PORT=3000
HOST=0.0.0.0

# Where the database lives. Back this file up.
DATABASE_PATH=/var/lib/kindle-dashboard/kindle-dashboard.db

# Set to false after everyone you want has made an account.
ALLOW_SIGNUP=true

# Leave false on a home network (plain http). Set true only if you put HTTPS in front.
SECURE_COOKIES=false

# Time zone used to show when words were looked up. Use your Kindle's time zone.
# List them with: timedatectl list-timezones
TZ=America/Toronto

# Optional: a plain book list at /shelf that old e-reader browsers (like a Kobo Touch)
# can open to download books from your Calibre server. Use a Calibre login from
# `calibre-server --manage-users`.
#CALIBRE_URL=http://127.0.0.1:8080
#CALIBRE_USER=
#CALIBRE_PASSWORD=
